# Copy to .env and adjust. Used by docker-compose.yml.
GO_VERSION=1.25
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=usermanagement
# Browser origin of the frontend (the only origin allowed by CORS)
CORS_ALLOWED_ORIGIN=http://localhost:5173
MAX_BODY_BYTES=1048576
LOG_LEVEL=info
BACKEND_PORT=8080
FRONTEND_PORT=5173
# URL the browser uses to reach the backend
VITE_API_BASE_URL=http://localhost:8080
